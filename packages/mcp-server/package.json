{
  "name": "@tempad-dev/mcp",
  "version": "0.11.0",
  "description": "Connect coding agents to Figma for design inspection, native canvas editing, and UI implementation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecomfe/tempad-dev.git",
    "directory": "packages/mcp-server"
  },
  "bin": "dist/cli.mjs",
  "files": [
    "README.md",
    "dist/**/*"
  ],
  "type": "module",
  "main": "dist/cli.mjs",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --config vitest.config.ts",
    "test:run": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "check:bridge-compatibility": "pnpm build && node scripts/check-bridge-compatibility.mjs",
    "check:logging": "node scripts/check-log-transport.mjs",
    "lint": "eslint . --ext .ts,.mts,.cts,.js,.mjs,.cjs",
    "lint:fix": "eslint . --fix --ext .ts,.mts,.cts,.js,.mjs,.cjs",
    "format": "oxfmt -c ../../.oxfmtrc.json --ignore-path ../../.gitignore",
    "format:check": "oxfmt -c ../../.oxfmtrc.json --ignore-path ../../.gitignore --check",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "nanoid": "^6.0.2",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "proper-lockfile": "^4.1.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tempad-dev/shared": "workspace:^0.1.0",
    "@types/node": "^24.19.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ws": "^8.18.2",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "unplugin-raw": "^0.8.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22 || ^24 || >=26"
  }
}
