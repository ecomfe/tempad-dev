{
  "name": "@tempad-dev/extension",
  "version": "0.23.4",
  "private": true,
  "description": "Create, edit, and implement Figma designs with your coding agent.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && pnpm run build:readme",
    "build:readme": "tsx ./build/readme.ts",
    "zip": "wxt zip",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "wxt prepare",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "lint:fix": "eslint . --fix --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "check:rewrite": "tsx ./scripts/check-rewrite.ts",
    "check:rewrite-runtime": "wxt build && tsx ./scripts/check-rewrite-runtime.ts",
    "check:plugin-sandbox": "wxt build && tsx ./scripts/check-plugin-sandbox.ts",
    "check:built-runtime": "tsx ./scripts/check-plugin-sandbox.ts && tsx ./scripts/check-rewrite-runtime.ts",
    "check:worker-sandbox": "tsx ./scripts/check-worker-sandbox.ts",
    "codex-plugin:reinstall": "tsx ./scripts/reinstall-codex-dev-plugin.ts",
    "agent-eval:authoring": "tsx ./scripts/inspect-agent-authoring-rollout.ts",
    "agent-eval:log": "tsx ./scripts/agent-authoring-run-log.ts",
    "agent-eval:preflight": "tsx ./scripts/agent-authoring-runtime-preflight.ts",
    "agent-eval:skills": "tsx ./scripts/inspect-agent-skill-catalog.ts",
    "screenshots": "tsx ./scripts/screenshots.ts",
    "test": "vitest --config vitest.config.ts",
    "test:run": "wxt build && pnpm run test:built",
    "test:built": "vitest run --config vitest.config.ts && pnpm run check:worker-sandbox && pnpm run check:built-runtime",
    "test:node": "vitest run --config vitest.node.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:headed": "vitest run --config vitest.browser.config.ts --browser.headless=false",
    "test:setup": "pnpm exec playwright install chromium",
    "test:coverage": "vitest run --config vitest.node.config.ts --coverage",
    "format": "oxfmt -c ../../.oxfmtrc.json --ignore-path ../../.gitignore",
    "format:check": "oxfmt -c ../../.oxfmtrc.json --ignore-path ../../.gitignore --check"
  },
  "dependencies": {
    "@tempad-dev/plugins": "workspace:^0.6.2",
    "@tempad-dev/shared": "workspace:^0.1.0",
    "@vueuse/core": "^15.0.0",
    "es-module-lexer": "3.0.3",
    "overlayscrollbars": "^2.16.0",
    "p-wait-for": "^6.0.0",
    "stringify-object": "^7.0.0",
    "svgson": "^5.3.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.141.0",
    "@types/node": "^24.19.2",
    "@types/prismjs": "^1.26.6",
    "@types/stringify-object": "^4.0.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/browser-playwright": "5.0.4",
    "@wxt-dev/module-vue": "^1.0.3",
    "comment-mark": "^2.2.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.0",
    "prismjs": "^1.30.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "8.3.4",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vitest": "5.0.4",
    "vue-tsc": "^3.3.13",
    "wxt": "^0.21.4",
    "zod": "^4.6.7"
  }
}
