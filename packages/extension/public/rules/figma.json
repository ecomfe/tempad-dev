[
  {
    "id": 1,
    "priority": 10,
    "action": {
      "type": "modifyHeaders",
      "responseHeaders": [
        {
          "header": "Content-Security-Policy",
          "operation": "remove"
        }
      ]
    },
    "condition": {
      "requestDomains": ["www.figma.com"],
      "regexFilter": "^https://www\\.figma\\.com/",
      "resourceTypes": ["main_frame"]
    }
  },
  {
    "id": 2,
    "priority": 1,
    "action": {
      "type": "redirect",
      "redirect": {
        "extensionPath": "/figma.js"
      }
    },
    "condition": {
      "requestDomains": ["www.figma.com"],
      "initiatorDomains": ["www.figma.com"],
      "regexFilter": "^https://www\\.figma\\.com/webpack-artifacts/assets/(?:figma_app[^.]+|[0-9a-zA-Z-]+)\\.min\\.js(?:\\.br)?$",
      "resourceTypes": ["script"]
    }
  }
]
