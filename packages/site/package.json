{
  "name": "@tempad-dev/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && pnpm build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "typecheck": "vue-tsc --build",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "format": "oxfmt -c ../../.oxfmtrc.json --ignore-path ../../.gitignore",
    "format:check": "oxfmt -c ../../.oxfmtrc.json --ignore-path ../../.gitignore --check",
    "test:run": "vitest run && pnpm test:browser",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:setup": "pnpm exec playwright install chromium"
  },
  "dependencies": {
    "@tempad-dev/shared": "workspace:^0.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vueuse/core": "^14.4.0",
    "lucide-vue-next": "^1.0.0",
    "overlayscrollbars": "^2.16.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "5.0.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "marked": "^18.0.13",
    "playwright": "^1.63.0",
    "typescript": "~6.0.3",
    "vite": "8.3.0",
    "vue-tsc": "^3.3.11",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
