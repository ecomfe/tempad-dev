{
  "name": "tempad-dev",
  "private": true,
  "description": "Create, edit, and implement Figma designs with your coding agent.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @tempad-dev/shared build && pnpm --filter @tempad-dev/mcp build && pnpm -r --parallel --filter @tempad-dev/shared --filter @tempad-dev/mcp --filter @tempad-dev/extension dev",
    "dev:site": "pnpm --filter @tempad-dev/site dev",
    "build": "pnpm -r build",
    "build:site": "pnpm --filter @tempad-dev/site... build",
    "build:ext": "pnpm --filter @tempad-dev/extension build",
    "build:plugins": "pnpm --filter @tempad-dev/plugins build",
    "build:mcp": "pnpm --filter @tempad-dev/mcp build",
    "mcp:check-bridge": "pnpm --filter @tempad-dev/shared build && pnpm --filter @tempad-dev/mcp check:bridge-compatibility",
    "mcp:check-profiles": "pnpm --filter @tempad-dev/shared build && pnpm build:mcp && node packages/mcp-server/scripts/check-runtime-profiles.mjs",
    "mcp:check-host-context": "pnpm --filter @tempad-dev/shared build && pnpm build:mcp && node packages/mcp-server/scripts/check-host-context.mjs",
    "mcp:check-runtime-prototype": "pnpm --filter @tempad-dev/shared build && pnpm --filter @tempad-dev/mcp exec tsdown --config tsdown.prototype.config.ts && node packages/mcp-server/scripts/check-runtime-prototype.mjs",
    "mcp:measure-runtime": "node packages/mcp-server/scripts/measure-runtime.mjs",
    "mcp:measure-hooks": "node packages/mcp-server/scripts/measure-hooks.mjs",
    "screenshots": "pnpm --filter @tempad-dev/extension screenshots",
    "test": "pnpm -r --parallel --if-present test",
    "test:run": "pnpm -r --if-present test:run",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm lint:root && pnpm -r --if-present lint",
    "lint:fix": "pnpm lint:root:fix && pnpm -r --if-present lint:fix",
    "lint:root": "eslint . --ignore-pattern \"packages/**\"",
    "lint:root:fix": "eslint . --fix --ignore-pattern \"packages/**\"",
    "agent-plugin:build": "node scripts/build-agent-plugin.mjs",
    "agent-plugin:check-installer": "node scripts/check-agent-plugin-installer.mjs",
    "agent-plugin:check-version": "node scripts/check-agent-plugin-version.mjs",
    "agent-plugin:reinstall": "pnpm --filter @tempad-dev/extension codex-plugin:reinstall",
    "agent-eval:authoring": "pnpm --filter @tempad-dev/extension agent-eval:authoring",
    "agent-eval:log": "pnpm --filter @tempad-dev/extension agent-eval:log",
    "agent-eval:preflight": "pnpm --filter @tempad-dev/extension agent-eval:preflight",
    "agent-eval:skills": "pnpm --filter @tempad-dev/extension agent-eval:skills",
    "format": "pnpm format:root && pnpm -r --if-present format",
    "format:check": "pnpm format:root:check && pnpm -r --if-present format:check",
    "format:root": "oxfmt --ignore-path ./.gitignore --ignore-path ./.oxfmtignore",
    "format:root:check": "oxfmt --ignore-path ./.gitignore --ignore-path ./.oxfmtignore --check",
    "typecheck": "pnpm typecheck:root && pnpm -r --if-present typecheck",
    "typecheck:root": "tsc -p tsconfig.configs.json",
    "zip": "pnpm --filter @tempad-dev/extension zip",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.19.1",
    "@vitest/coverage-istanbul": "5.0.3",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.11.0",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-vue": "^10.11.1",
    "globby": "^16.2.4",
    "jiti": "^2.7.0",
    "lefthook": "^2.1.16",
    "oxfmt": "^0.71.0",
    "typescript": "^6.0.3",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.8.2"
}
